# Server-only variables in the Vercel project. Never put them into the Mac app.
LECTERN_ORIGIN=https://lectern-app.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
GOOGLE_CLIENT_ID=YOUR_WEB_APPLICATION_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_WEB_APPLICATION_CLIENT_SECRET
# Random secret for the daily expired-token/upload cleanup job.
CRON_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET
